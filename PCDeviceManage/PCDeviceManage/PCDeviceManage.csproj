<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK 版本号让 WinRT API（Windows.Devices.Display）直接可用；DisplayMonitor 需要 1803 及以上。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>PCDeviceManage</RootNamespace>
    <AssemblyName>PCDeviceManage</AssemblyName>
    <ApplicationIcon>ico\app.ico</ApplicationIcon>
    <Product>PCDeviceManage</Product>
    <Copyright>Copyright © 2022</Copyright>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ico\app.ico" LogicalName="PCDeviceManage.app.ico" />
    <EmbeddedResource Include="Web\wwwroot\index.html" LogicalName="PCDeviceManage.wwwroot.index.html" />
    <EmbeddedResource Include="Web\wwwroot\login.html" LogicalName="PCDeviceManage.wwwroot.login.html" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="frp\frpc.example.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Update="frp\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- frpc.ini 和 frpc.exe 不入库，存在时才复制到输出目录。 -->
    <None Update="frp\frpc.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="frp\frpc.exe" Condition="Exists('frp\frpc.exe')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
