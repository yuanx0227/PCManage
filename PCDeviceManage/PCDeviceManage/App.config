<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 端口、监听地址、访问令牌、frp 开关等配置保存在 %LocalAppData%\PCManage\settings.json。
       旧版本写在这里的 WebPort / WebHost / AccessToken 会在首次启动时迁移过去。 -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
</configuration>
